# --- Supabase ---
# Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never expose to the client):
# SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (waitlist confirmation emails) ---
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Optional override of the From address. Default uses Resend's testing sender,
# which works without verifying a domain. For production, verify your domain
# (https://resend.com/domains) and set: RESEND_FROM="Spotlights <hello@spotlightsapp.com>"
# RESEND_FROM=Spotlights <onboarding@resend.dev>

# --- Optional: site URL used in email links ---
# NEXT_PUBLIC_SITE_URL=https://spotlightsapp.com
